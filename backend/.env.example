PORT=4000
CLIENT_ORIGIN=*
UPLOAD_DIR=

# Use one Firebase Admin credential option.
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_STORAGE_BUCKET=

# Optional AI coach. If omitted or unavailable, the app uses the built-in fallback coach.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
